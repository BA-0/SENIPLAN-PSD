# Copier vers /etc/senico-diagnostic/backend.env en production (charge par systemd EnvironmentFile).
# En local, ces valeurs peuvent aussi etre exportees dans le shell ou definies dans la config
# "Run/Debug" de l'IDE — Spring Boot ne charge pas automatiquement un fichier .env.

# Base de donnees MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_NAME=senico_diagnostic
DB_USER=senico_app
DB_PASSWORD=change-me

# JWT — generer une valeur aleatoire forte (>= 256 bits) en production
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — origines autorisees (separees par des virgules)
CORS_ALLOWED_ORIGINS=https://diagnostic.senico.sn

# Serveur
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
