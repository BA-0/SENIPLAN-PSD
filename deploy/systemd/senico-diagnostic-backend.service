[Unit]
Description=SENICO Diagnostic Strategique - Backend Spring Boot
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=senico
Group=senico
WorkingDirectory=/opt/senico-diagnostic/backend
EnvironmentFile=/etc/senico-diagnostic/backend.env
Environment="SPRING_PROFILES_ACTIVE=prod"
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/senico-diagnostic/backend/diagnostic-strategique.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/senico-diagnostic/backend.log
StandardError=append:/var/log/senico-diagnostic/backend-error.log

# Durcissement basique
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
